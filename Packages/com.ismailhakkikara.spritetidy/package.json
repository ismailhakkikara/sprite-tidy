  "changelogUrl": "https://github.com/ismailhakkikara/sprite-tidy/blob/main/Packages/com.ismailhakkikara.spritetidy/CHANGELOG.md",
  "licensesUrl": "https://github.com/ismailhakkikara/sprite-tidy/blob/main/LICENSE",
  "keywords": [
    "sprite",
    "spritesheet",
    "2d",
    "texture",
    "background-removal",
